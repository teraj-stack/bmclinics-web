generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum VisitStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      Role      @default(PATIENT)
  createdAt DateTime  @default(now())

  patient  Patient?
  doctor   Doctor?
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Patient {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits Visit[]
  orders Order[]
}

model Doctor {
  id                    String  @id @default(cuid())
  userId                String  @unique
  specialization        String
  googleRefreshTokenEnc String?
  googleCalendarId      String?
  workStartHour         Int     @default(9)
  workEndHour           Int     @default(17)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits Visit[]
}

model Service {
  id              String @id @default(cuid())
  slug            String @unique
  categorySlug    String
  name            String
  priceGrosze     Int
  durationMin     Int
  seoSummary      String
  fullDescription String

  visits     Visit[]
  orderItems OrderItem[]
}

model Visit {
  id            String      @id @default(cuid())
  patientId     String
  doctorId      String
  serviceId     String
  startTime     DateTime
  endTime       DateTime
  status        VisitStatus @default(PROPOSED)
  googleEventId String?
  createdAt     DateTime    @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([doctorId, startTime])
}

model Order {
  id            String      @id @default(cuid())
  sessionId     String      @unique
  p24OrderId    Int?
  patientId     String?
  customerEmail String
  amountGrosze  Int
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  paidAt        DateTime?

  patient Patient?    @relation(fields: [patientId], references: [id])
  items   OrderItem[]

  @@index([status])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  serviceId   String
  quantity    Int
  priceGrosze Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
}
