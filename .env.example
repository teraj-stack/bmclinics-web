# --- Baza danych (lokalnie: docker compose up -d) ---
DATABASE_URL="postgresql://bmclinics:bmclinics@localhost:5432/klinika?schema=public"

# --- Adres aplikacji ---
# Lokalnie: http://localhost:3000. Na produkcji USTAW dokładnie kanoniczny host:
# https://bmclinic.net — obie wartości NEXT_PUBLIC_BASE_URL i NEXTAUTH_URL muszą wskazywać ten sam URL.
# Kontakt mailowy pozostaje kontakt@bujokmedical.pl (nie jest hostem strony).
NEXT_PUBLIC_BASE_URL="https://bmclinic.net"

# --- NextAuth ---
NEXTAUTH_URL="https://bmclinic.net"
NEXTAUTH_SECRET="wygeneruj-losowy-ciag-np-openssl-rand-base64-32"

# --- Logowanie e-mail (magic link) ---
EMAIL_SERVER="smtp://user:password@smtp.dostawca.pl:587"
EMAIL_FROM="kontakt@bujokmedical.pl"

# --- Przelewy24 ---
P24_MERCHANT_ID=""
P24_POS_ID=""
P24_API_KEY=""
P24_CRC=""
P24_SANDBOX="true"

# --- Google Calendar OAuth (konta lekarzy) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Cloud KMS (szyfrowanie tokenów Google Calendar) ---
GCP_PROJECT_ID=""
KMS_LOCATION="europe-central2"
KMS_KEY_RING="clinic-keyring"
KMS_KEY_NAME="doctor-token-key"

# --- Kontakt (formularz publiczny) ---
CONTACT_EMAIL="kontakt@bujokmedical.pl"
